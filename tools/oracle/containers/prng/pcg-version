#!/bin/sh
# Print the pinned pcg-c commit, or the recorded one and a failure.
set -eu
got=$(cat /usr/local/share/ghoti-oracle/pcg-c-commit)
case $got in
  83252d9c23df9c82ecb42210afed61a7b42402d7)
    printf '%s\n' 'pcg-c 83252d9c23df9c82ecb42210afed61a7b42402d7'
    ;;
  *)
    printf '%s\n' "$got" >&2
    exit 1
    ;;
esac
